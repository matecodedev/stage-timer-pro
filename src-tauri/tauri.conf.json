{
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devPath": "http://localhost:5173",
    "distDir": "../dist"
  },
  "package": {
    "productName": "Stage Timer Pro",
    "version": "1.0.5"
  },
  "tauri": {
    "bundle": {
      "active": true,
      "identifier": "com.matecode.stage-timer",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ],
      "copyright": "© 2025 MateCode. Licencia MIT.",
      "shortDescription": "Timer profesional para eventos",
      "longDescription": "Aplicación profesional de timer para eventos con branding personalizable, soporte dual monitor, sistema de mensajes avanzado y funcionalidades para presentaciones profesionales.",
      "targets": ["msi", "nsis"],
      "windows": {
        "certificateThumbprint": null,
        "digestAlgorithm": "sha256",
        "timestampUrl": "",
        "wix": {
          "language": "en-US"
        },
        "nsis": {
          "license": "../LICENSE",
          "installerIcon": "icons/icon.ico",
          "headerImage": null,
          "sidebarImage": null,
          "installMode": "currentUser",
          "languages": ["English", "Spanish"],
          "displayLanguageSelector": true
        }
      }
    },
    "security": {
      "csp": null
    },
    "windows": [
      {
        "label": "main",
        "title": "Stage Timer Dashboard",
        "fullscreen": false,
        "resizable": true,
        "width": 1400,
        "height": 900,
        "minWidth": 1200,
        "minHeight": 800,
        "x": 50,
        "y": 50,
        "maximized": true
      }
    ],
    "allowlist": {
      "all": false,
      "shell": {
        "all": false,
        "open": false
      },
      "dialog": {
        "all": false,
        "ask": false,
        "confirm": false,
        "message": false,
        "open": false,
        "save": false
      },
      "window": {
        "all": false,
        "close": true,
        "hide": true,
        "show": true,
        "maximize": true,
        "minimize": true,
        "unmaximize": true,
        "unminimize": true,
        "startDragging": true,
        "print": false,
        "setResizable": true,
        "setTitle": true,
        "setSize": true,
        "setMinSize": true,
        "setMaxSize": true,
        "setPosition": true,
        "setFullscreen": true,
        "setFocus": true,
        "setIcon": false,
        "setSkipTaskbar": false,
        "setCursorGrab": false,
        "setCursorVisible": true,
        "setDecorations": true,
        "setContentProtected": false,
        "setAlwaysOnTop": true,
        "center": true,
        "requestUserAttention": false
      },
      "notification": {
        "all": true
      },
      "globalShortcut": {
        "all": true
      },
      "os": {
        "all": false
      },
      "path": {
        "all": false
      },
      "protocol": {
        "all": false,
        "asset": false,
        "assetScope": []
      },
      "fs": {
        "all": false,
        "readFile": false,
        "writeFile": false,
        "readDir": false,
        "copyFile": false,
        "createDir": false,
        "removeDir": false,
        "removeFile": false,
        "renameFile": false,
        "exists": false
      },
      "clipboard": {
        "all": false,
        "writeText": false,
        "readText": false
      },
      "http": {
        "all": false,
        "request": false
      }
    }
  }
}
